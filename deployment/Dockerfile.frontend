# ============================================================================
# LIFE OS FRONTEND DOCKERFILE (REACT + VITE MULTI-STAGE BUILD)
# ============================================================================
# STAGE 1: Build static distribution bundle
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package manifests
COPY frontend/package*.json ./

# Install npm packages
RUN npm ci

# Copy frontend source files
COPY frontend ./

# Build production distribution assets
RUN npm run build

# STAGE 2: Serve static production assets via NGINX
FROM nginx:alpine

# Copy built distribution files to NGINX HTML root
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose default HTTP port
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
